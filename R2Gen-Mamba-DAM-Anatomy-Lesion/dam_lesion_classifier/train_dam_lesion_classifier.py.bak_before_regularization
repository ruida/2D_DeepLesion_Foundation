#!/usr/bin/env python3
import argparse, json, os, random
from collections import Counter
from pathlib import Path

import numpy as np
import torch
import torch.nn as nn
from PIL import Image, ImageDraw
from sklearn.metrics import accuracy_score, classification_report, f1_score
from torch.utils.data import DataLoader, Dataset, WeightedRandomSampler
from torchvision.transforms import functional as TF
from torchvision.transforms import InterpolationMode

from modules.visual_extractor import VisualExtractor
from models.r2gen import GatedGlobalLocalAdapter

PRIMARY_CLASSES = ['other_lesion','lymph_node','mass','nodule','cystic','opacity','consolidation']
ATTRIBUTE_CLASSES = ['none','low_density','enhancing','calcified']
IMAGENET_MEAN = (0.485, 0.456, 0.406)
IMAGENET_STD = (0.229, 0.224, 0.225)

class DAMClassifierDataset(Dataset):
    def __init__(self, ann_path, image_dir, split, image_size=224, crop_scale=3.0,
                 min_crop_size=48, bbox_format='xyxy', flip_prob=0.5):
        self.rows = json.load(open(ann_path))[split]
        self.image_dir = image_dir
        self.split = split
        self.image_size = image_size
        self.crop_scale = crop_scale
        self.min_crop_size = min_crop_size
        self.bbox_format = bbox_format
        self.flip_prob = flip_prob
        self.p2i = {x:i for i,x in enumerate(PRIMARY_CLASSES)}
        self.a2i = {x:i for i,x in enumerate(ATTRIBUTE_CLASSES)}

    def __len__(self): return len(self.rows)

    @staticmethod
    def first_box(x):
        b = x.get('bboxes', x.get('bbox', x.get('box')))
        if isinstance(b, dict): b = b.get('bbox', b.get('box'))
        if b and isinstance(b[0], (list,tuple)): b = b[0]
        if b is None or len(b) != 4: raise ValueError(f"bad bbox for {x.get('id')}: {b}")
        return [float(v) for v in b]

    def to_xyxy(self, b, w, h):
        if self.bbox_format == 'xyxy': x1,y1,x2,y2 = b
        elif self.bbox_format == 'xywh':
            x,y,bw,bh = b; x1,y1,x2,y2 = x,y,x+bw,y+bh
        elif self.bbox_format == 'yolo':
            cx,cy,bw,bh = b
            x1=(cx-bw/2)*w; y1=(cy-bh/2)*h; x2=(cx+bw/2)*w; y2=(cy+bh/2)*h
        else: raise ValueError(self.bbox_format)
        x1=max(0,min(w-1,x1)); y1=max(0,min(h-1,y1))
        x2=max(x1+1,min(w,x2)); y2=max(y1+1,min(h,y2))
        return x1,y1,x2,y2

    def expand_box(self, b, w, h):
        x1,y1,x2,y2=b; cx=(x1+x2)/2; cy=(y1+y2)/2
        bw=max(x2-x1,float(self.min_crop_size))*self.crop_scale
        bh=max(y2-y1,float(self.min_crop_size))*self.crop_scale
        return (max(0,int(round(cx-bw/2))), max(0,int(round(cy-bh/2))),
                min(w,int(round(cx+bw/2))), min(h,int(round(cy+bh/2))))

    def rgb_mask_tensor(self, image, mask):
        image = TF.resize(image,[self.image_size,self.image_size],InterpolationMode.BILINEAR,antialias=True)
        mask = TF.resize(mask,[self.image_size,self.image_size],InterpolationMode.NEAREST)
        image = TF.normalize(TF.to_tensor(image), IMAGENET_MEAN, IMAGENET_STD)
        mask = TF.to_tensor(mask)[:1]
        return torch.cat([image,mask],0)

    def __getitem__(self, idx):
        x=self.rows[idx]; p=x['image_path']; p=p[0] if isinstance(p,(list,tuple)) else p
        image=Image.open(os.path.join(self.image_dir,p)).convert('RGB'); w,h=image.size
        box=self.to_xyxy(self.first_box(x),w,h); x1,y1,x2,y2=box
        mp=x.get('mask_path')
        if mp:
            mask=Image.open(os.path.join(self.image_dir,mp)).convert('L')
            if mask.size != image.size: raise ValueError(f"size mismatch {x['id']}")
            mask=mask.point(lambda v:255 if v>0 else 0, mode='L')
        else:
            mask=Image.new('L',(w,h),0)
            ImageDraw.Draw(mask).rectangle([round(x1),round(y1),max(round(x1),round(x2)-1),max(round(y1),round(y2)-1)],fill=255)
        cb=self.expand_box(box,w,h); focal=image.crop(cb); fmask=mask.crop(cb)
        if self.split=='train' and random.random()<self.flip_prob:
            image=TF.hflip(image); mask=TF.hflip(mask); focal=TF.hflip(focal); fmask=TF.hflip(fmask)
        images=torch.stack([self.rgb_mask_tensor(image,mask),self.rgb_mask_tensor(focal,fmask)],0)
        return x['id'], images, self.p2i[x['oracle_primary_lesion_type']], self.a2i[x['oracle_lesion_attribute']]

class DAMLesionClassifier(nn.Module):
    def __init__(self, backbone='resnet18', pretrained=True, adapter_dim=256, heads=8, dropout=0.2):
        super().__init__()
        class A: pass
        a=A(); a.visual_extractor=backbone; a.visual_extractor_pretrained=pretrained; a.use_dam=True
        self.encoder=VisualExtractor(a)
        dim = 512 if backbone in ('resnet18','resnet34') else 2048
        self.adapter=GatedGlobalLocalAdapter(dim,adapter_dim,heads,dropout)
        self.norm=nn.LayerNorm(dim)
        self.drop=nn.Dropout(dropout)
        self.primary=nn.Linear(dim,len(PRIMARY_CLASSES))
        self.attribute=nn.Linear(dim,len(ATTRIBUTE_CLASSES))
    def forward(self, x):
        gt,gf=self.encoder(x[:,0]); lt,lf=self.encoder(x[:,1])
        fused=self.adapter(lt,gt).mean(1)
        z=self.drop(self.norm(fused))
        return self.primary(z), self.attribute(z)

def weights(rows,key,classes):
    c=Counter(x[key] for x in rows); n=sum(c.values())
    return torch.tensor([n/(len(classes)*max(c[k],1)) for k in classes],dtype=torch.float32)

def run_epoch(model,loader,device,opt,cp,ca,lam):
    train=opt is not None; model.train(train); total=0; ys=[]; ps=[]; ya=[]; pa=[]
    for _,x,y1,y2 in loader:
        x=x.to(device); y1=y1.to(device); y2=y2.to(device)
        with torch.set_grad_enabled(train):
            o1,o2=model(x); loss=cp(o1,y1)+lam*ca(o2,y2)
            if train: opt.zero_grad(); loss.backward(); opt.step()
        total += loss.item()*x.size(0); ys += y1.cpu().tolist(); ps += o1.argmax(1).cpu().tolist(); ya += y2.cpu().tolist(); pa += o2.argmax(1).cpu().tolist()
    return {'loss':total/len(loader.dataset),'primary_acc':accuracy_score(ys,ps),'primary_macro_f1':f1_score(ys,ps,average='macro',zero_division=0),'attribute_acc':accuracy_score(ya,pa),'attribute_macro_f1':f1_score(ya,pa,average='macro',zero_division=0)}, (ys,ps,ya,pa)

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--ann_path',required=True); ap.add_argument('--image_dir',required=True); ap.add_argument('--save_dir',required=True)
    ap.add_argument('--backbone',default='resnet18'); ap.add_argument('--batch_size',type=int,default=32); ap.add_argument('--epochs',type=int,default=50)
    ap.add_argument('--lr',type=float,default=1e-4); ap.add_argument('--num_workers',type=int,default=4); ap.add_argument('--attribute_lambda',type=float,default=0.5)
    ap.add_argument('--image_size',type=int,default=224); ap.add_argument('--crop_scale',type=float,default=3.0); ap.add_argument('--min_crop_size',type=int,default=48)
    ap.add_argument('--bbox_format',default='xyxy'); ap.add_argument('--adapter_dim',type=int,default=256); ap.add_argument('--num_heads',type=int,default=8)
    ap.add_argument('--seed',type=int,default=9223); ap.add_argument('--patience',type=int,default=10)
    args=ap.parse_args(); Path(args.save_dir).mkdir(parents=True,exist_ok=True)
    random.seed(args.seed); np.random.seed(args.seed); torch.manual_seed(args.seed); torch.cuda.manual_seed_all(args.seed)
    tr=DAMClassifierDataset(args.ann_path,args.image_dir,'train',args.image_size,args.crop_scale,args.min_crop_size,args.bbox_format)
    va=DAMClassifierDataset(args.ann_path,args.image_dir,'val',args.image_size,args.crop_scale,args.min_crop_size,args.bbox_format,0)
    te=DAMClassifierDataset(args.ann_path,args.image_dir,'test',args.image_size,args.crop_scale,args.min_crop_size,args.bbox_format,0)
    raw=json.load(open(args.ann_path)); sample_w=weights(raw['train'],'oracle_primary_lesion_type',PRIMARY_CLASSES)
    p2i={x:i for i,x in enumerate(PRIMARY_CLASSES)}; sw=[sample_w[p2i[x['oracle_primary_lesion_type']]].item() for x in raw['train']]
    sampler=WeightedRandomSampler(sw,len(sw),replacement=True)
    kw=dict(batch_size=args.batch_size,num_workers=args.num_workers,pin_memory=True)
    tl=DataLoader(tr,sampler=sampler,**kw); vl=DataLoader(va,shuffle=False,**kw); tel=DataLoader(te,shuffle=False,**kw)
    dev=torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    m=DAMLesionClassifier(args.backbone,True,args.adapter_dim,args.num_heads).to(dev)
    cp=nn.CrossEntropyLoss(weight=weights(raw['train'],'oracle_primary_lesion_type',PRIMARY_CLASSES).to(dev))
    ca=nn.CrossEntropyLoss(weight=weights(raw['train'],'oracle_lesion_attribute',ATTRIBUTE_CLASSES).to(dev))
    opt=torch.optim.AdamW(m.parameters(),lr=args.lr,weight_decay=1e-4)
    best=-1; bad=0
    for ep in range(1,args.epochs+1):
        trm,_=run_epoch(m,tl,dev,opt,cp,ca,args.attribute_lambda); vm,_=run_epoch(m,vl,dev,None,cp,ca,args.attribute_lambda)
        score=vm['primary_macro_f1']; print('epoch',ep,'train',trm,'val',vm,flush=True)
        torch.save({'model':m.state_dict(),'args':vars(args),'classes':{'primary':PRIMARY_CLASSES,'attribute':ATTRIBUTE_CLASSES}},Path(args.save_dir)/'last.pt')
        if score>best:
            best=score; bad=0; torch.save({'model':m.state_dict(),'args':vars(args),'classes':{'primary':PRIMARY_CLASSES,'attribute':ATTRIBUTE_CLASSES}},Path(args.save_dir)/'best.pt')
        else:
            bad+=1
            if bad>=args.patience: break
    ck=torch.load(Path(args.save_dir)/'best.pt',map_location=dev); m.load_state_dict(ck['model'])
    tm,(y1,p1,y2,p2)=run_epoch(m,tel,dev,None,cp,ca,args.attribute_lambda); print('TEST',tm)
    print('\nPRIMARY\n',classification_report(y1,p1,target_names=PRIMARY_CLASSES,digits=4,zero_division=0))
    print('\nATTRIBUTE\n',classification_report(y2,p2,target_names=ATTRIBUTE_CLASSES,digits=4,zero_division=0))
    json.dump(tm,open(Path(args.save_dir)/'test_metrics.json','w'),indent=2)

if __name__=='__main__': main()
